feature jalt {
# Justification Alternates

    sub yeh.isol.skl  by  yeh.isol.skl.ss02;
    sub seen.isol.skl  by  seen.isol.skl.ss02;
    sub seen.init.skl  by  seen.init.skl.ss02;
    sub [keheh.init.skl keheh.medi.skl keheh.fina.skl keheh.isol.skl]  by  [kafswash.init.skl kafswash.medi.skl kafswash.fina.skl kafswash.isol.skl];

#< feature
} jalt;
feature kern {
  lookup kern_withBase {
   	pos [threedotbelow.mrk H-twodotbelow.mrk V-twodotbelow.mrk dotbelow.mrk R-threedotbelow.mrk]  yeh.fina.skl <50 -350 0 0>;
