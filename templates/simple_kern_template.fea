# =============================================================================
# جدول ساده‌ی جابجاییِ نقطه‌ها (یک خط = یک مقدار)
# =============================================================================
# هر خط یعنی: «وقتی این دو گلیف کنار هم اومدن، گلیف دوم رو به این اندازه
# جابجا کن». نیازی به هیچ لوکاپِ اضافه یا شرطِ جداگانه نیست.
#
# فرمت هر خط:
#   pos <گلیف اول> <گلیف دوم> <dx dy 0 0>;
#
#   dx = جابجایی افقی (مثبت = راست، منفی = چپ)
#   dy = جابجایی عمودی (مثبت = بالا، منفی = پایین)
#   دو تای آخر همیشه صفر بمونه (اونا برای تغییر عرضِ پیشرفت‌ان، نه موقعیت)
#
# فقط همین خط رو تکرار کنید و مقادیر رو عوض کنید:
# =============================================================================

feature kern {

  pos alef.fina.skl dotbelow.mrk <100 -30 0 0>;
  pos reh.isol.skl dotabove.mrk <-50 20 0 0>;

  # از همین‌جا به بعد، فقط خط اضافه کنید:
  # pos <گلیف اول> <گلیف دوم> <dx dy 0 0>;

} kern;
